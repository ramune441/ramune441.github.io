# 録画用一時ファイル（録画後に削除するもの）
node_modules/
__pycache__/
package.json
package-lock.json
record.mjs
record-store.mjs
record-*.mjs
!sendready-chrome/record-story.mjs
add-audio-*.mjs
_frames/
_frames_guide/
_probe/

# BGM 音源（ライセンス品。公開リポジトリに置かない）
mp3/

# BGM 前の中間動画（audio/ 配下の完成版から作り直せる）
ripen/images/promo/promo-*.mp4
kura/images/promo/promo-*.mp4
kura/images/promo/promo-audio.wav

# SendReady 実録版の4K動画（record-story.mjs の録画から build-story.mjs で作り直せる）
sendready-chrome/story/*.mp4


# YouTube 投稿用・確認用の動画（生成スクリプトで作り直せる。サイトからは使わず、GitHub Pages の 1GB 上限を超えるので入れない）
formpilot/youtube-assets/**/*.mp4
formpilot/previews/*.mp4
subduo/previews/*.mp4
formpilot/promo-bn.mp4
formpilot/promo-it.mp4
formpilot/promo-nl.mp4
formpilot/promo-pl.mp4
formpilot/promo-th.mp4
formpilot/promo-tr.mp4
formpilot/promo-vi.mp4
formpilot/promo-zh-Hant.mp4
